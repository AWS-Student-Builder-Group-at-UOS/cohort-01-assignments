{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadIamForConsole",
      "Effect": "Allow",
      "Action": [
        "iam:ListUsers", "iam:ListRoles", "iam:ListPolicies",
        "iam:ListInstanceProfiles", "iam:GetAccountSummary",
        "iam:GetRole", "iam:GetRolePolicy", "iam:GetInstanceProfile",
        "iam:GetPolicy", "iam:GetPolicyVersion", "iam:ListPolicyVersions",
        "iam:ListAttachedRolePolicies", "iam:ListRolePolicies",
        "iam:ListInstanceProfilesForRole", "iam:ListRoleTags",
        "iam:ListInstanceProfileTags"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOwnUserPermissions",
      "Effect": "Allow",
      "Action": [
        "iam:GetUser", "iam:ListAttachedUserPolicies", "iam:ListUserPolicies",
        "iam:GetUserPolicy", "iam:ListGroupsForUser"
      ],
      "Resource": "arn:aws:iam::888195519399:user/i2na-asbg"
    },
    {
      "Sid": "ManagePortalRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:UpdateRole", "iam:DeleteRole",
        "iam:UpdateAssumeRolePolicy", "iam:TagRole", "iam:UntagRole",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::888195519399:role/i2na-asbg-role-web",
        "arn:aws:iam::888195519399:role/i2na-asbg-role-app"
      ]
    },
    {
      "Sid": "AttachSsmCoreToPortalRoles",
      "Effect": "Allow",
      "Action": ["iam:AttachRolePolicy", "iam:DetachRolePolicy"],
      "Resource": [
        "arn:aws:iam::888195519399:role/i2na-asbg-role-web",
        "arn:aws:iam::888195519399:role/i2na-asbg-role-app"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        }
      }
    },
    {
      "Sid": "ManagePortalInstanceProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateInstanceProfile", "iam:DeleteInstanceProfile",
        "iam:AddRoleToInstanceProfile", "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile", "iam:UntagInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::888195519399:instance-profile/i2na-asbg-role-web",
        "arn:aws:iam::888195519399:instance-profile/i2na-asbg-role-app"
      ]
    },
    {
      "Sid": "PassPortalRolesToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::888195519399:role/i2na-asbg-role-web",
        "arn:aws:iam::888195519399:role/i2na-asbg-role-app"
      ],
      "Condition": {
        "StringEquals": {"iam:PassedToService": "ec2.amazonaws.com"}
      }
    },
    {
      "Sid": "ReadSessionManagerStatus",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation", "ssm:DescribeInstanceProperties",
        "ssm:DescribeSessions", "ssm:GetConnectionStatus",
        "ssm:GetDocument", "ssm:DescribeDocument", "ssm:ListDocuments"
      ],
      "Resource": "*"
    },
    {
      "Sid": "StartSessionsOnPortalInstances",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ec2:ap-northeast-2:888195519399:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Name": ["i2na-asbg-ec2-web", "i2na-asbg-ec2-app"]
        }
      }
    },
    {
      "Sid": "UseShellSessionDocument",
      "Effect": "Allow",
      "Action": "ssm:StartSession",
      "Resource": "arn:aws:ssm:ap-northeast-2:888195519399:document/SSM-SessionManagerRunShell"
    },
    {
      "Sid": "ManageOwnSessions",
      "Effect": "Allow",
      "Action": [
        "ssm:ResumeSession", "ssm:TerminateSession", "ssmmessages:OpenDataChannel"
      ],
      "Resource": [
        "arn:aws:ssm:ap-northeast-2:888195519399:session/${aws:username}-*",
        "arn:aws:ssm:ap-northeast-2:888195519399:session/${aws:userid}-*"
      ]
    }
  ]
}
