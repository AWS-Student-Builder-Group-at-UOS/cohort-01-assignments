[Unit]
Description=Course registration API
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/portal-app.env
WorkingDirectory=/srv/portal/app
ExecStart=/usr/bin/node server.js
DynamicUser=yes
# Give the AWS SDK a home directory without relying on dynamic-user NSS lookup.
StateDirectory=portal-app
StateDirectoryMode=0700
Environment=HOME=/var/lib/portal-app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
